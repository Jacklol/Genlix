# Supabase server connection (never expose the secret key to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional comma-separated additional HTTPS hosts for legacy/external images.
# CMS_ALLOWED_MEDIA_HOSTS=cdn.example.com

# Admin login. Generate the hash with:
# node scripts/hash-admin-password.mjs "your-long-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:REPLACE_WITH_GENERATED_VALUE
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Local development works without this file and uses admin / admin.
# The insecure default is intentionally blocked in production.
